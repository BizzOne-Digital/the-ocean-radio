# Live stream URL (optional — when set, player uses the stream instead of Spotify programming)
NEXT_PUBLIC_RADIO_STREAM_URL=

# Spotify playlist IDs (share link → copy the ID). Site uses embed only — no server Spotify API.
# Daytime relaxing favorites (12 AM – 9 PM Philippine Time)
NEXT_PUBLIC_SPOTIFY_RELAXING_PLAYLIST_ID=
# Evening Christian Music (9 PM – 12 AM Philippine Time)
NEXT_PUBLIC_SPOTIFY_CHRISTIAN_PLAYLIST_ID=

# Optional ONE-TIME on your computer to fill spotifyId in JSON (see scripts/import-spotify-playlist-to-json.mjs)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_PLAYLIST_ID=

# Contact form delivery (optional)
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
